<Window x:Class="DEW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEW.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 = buttons -->
            <RowDefinition Height="*" /> <!-- 1 = entry list -->
            <RowDefinition Height="Auto" /> <!-- 2: key box-->
            <RowDefinition Height="200" /> <!-- 3: raw text-->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Load" ToolTip="Load content from JSON file" Command="{Binding LoadCommand}" Margin="0,0,5,0" />
            <Button Content="Create Entry" ToolTip="Create new entry within current JSON file" Command="{Binding CreateEntryCommand}" Margin="0,0,5,0" />
            <Button Content="Create/Edit Entry" ToolTip="Create new entry within current JSON file and open editor" Command="{Binding CreateEditEntryCommand}" Margin="0,0,5,0" />
            <Button Content="Delete" ToolTip="Delete currently selected entry" Command="{Binding DeleteCommand}" Margin="0,0,5,0" />
            <Button Content="▲" ToolTip="Move up" Command="{Binding MoveUpCommand}" Width ="28" Margin="0,0,5,0" />
            <Button Content="▼" ToolTip="Move down" Command="{Binding MoveDownCommand}" Width="28" Margin="0,0,5,0" />
            <Button Content="Save" ToolTip="Save changes to current JSON file" Command="{Binding SaveCommand}" Margin="0,0,5,0" />
            <Button Content="Save As" ToolTip="Save current JSON file as" Command="{Binding SaveAsCommand}" Margin="0,0,5,0" />
            <Button Content="New" ToolTip="Create a new, blank JSON file" Command="{Binding NewCommand}" />
        </StackPanel>

        <ListBox x:Name="EntriesListBox" Grid.Row="1" ItemsSource="{Binding Entries}" DisplayMemberPath="Key"
                    SelectedItem="{Binding SelectedEntry}"
                    AllowDrop="True" Drop="ListBox_Drop" DragOver="ListBox_DragOver">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_RightClick" />
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown" />
                    <EventSetter Event="PreviewMouseMove" Handler="ListBoxItem_PreviewMouseMove" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Duplicate Entry" Command="{Binding DuplicateCommand}" />
                    <MenuItem Header="Copy Value" Command="{Binding CopyValueCommand}" />
                    <Separator />
                    <MenuItem Header="Cut Entry" Command="{Binding CutCommand}" />
                    <MenuItem Header="Paste Entry" Command="{Binding PasteCommand}" />
                    <Separator />
                    <MenuItem Header="Delete Entry" Command="{Binding DeleteCommand}" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <TextBox Grid.Row="2" Text="{Binding EditingKey, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="KeyTextBox_LostFocus" Margin="0,2,0,2" />

        <TextBox Grid.Row="3" Text="{Binding SelectedEntry.RawText}"
                    TextWrapping="Wrap" AcceptsReturn="True" />
    </Grid>
</Window>
