<Window x:Class="DEW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DEW.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Entries}" DisplayMemberPath="Key"
                    SelectedItem="{Binding SelectedEntry}" />

        <TextBox Grid.Row="1" Text="{Binding EditingKey, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="KeyTextBox_LostFocus" Margin="0,5,0,5" />

        <TextBox Grid.Row="2" Text="{Binding SelectedEntry.RawText}"
                    TextWrapping="Wrap" AcceptsReturn="True" />

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="Load" Command="{Binding LoadCommand}" Margin="0,0,5,0" />
            <Button Content="Create Entry" Command="{Binding CreateEntryCommand}" Margin="0,0,5,0" />
            <Button Content="Create/Edit Entry" Command="{Binding CreateEditEntryCommand}" Margin="0,0,5,0" />
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,5,0" />
            <Button Content="Save As" Command="{Binding SaveAsCommand}" Margin="0,0,5,0" />
            <Button Content="New" Command="{Binding NewCommand}" />
        </StackPanel>
    </Grid>
</Window>
